# Salin ke .env.local lalu isi. Jangan commit file .env apa pun.
# Penjelasan tiap variabel: docs/SERAH-TERIMA.md bagian 4.

# URL dasar aplikasi per lingkungan (tanpa garis miring di akhir)
APP_URL=http://localhost:3000

# Supabase. DATABASE_URL = pooler mode transaction (port 6543), DATABASE_URL_DIRECT = koneksi langsung (hanya migrasi).
DATABASE_URL=
DATABASE_URL_DIRECT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile. Nilai di bawah adalah kunci uji resmi Cloudflare (selalu lolos), hanya untuk development.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis (rate limit). Boleh kosong di development; wajib di staging dan production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email lewat Resend (worker outbox). EMAIL_FROM contoh: "Presync ISC <notifikasi@mail.informaticstudyclub.com>"
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Secret acak, buat dengan: openssl rand -base64 48
# CARD_SECRET minimal 32 karakter dan JANGAN diganti sembarangan (lihat SERAH-TERIMA bagian 6).
CARD_SECRET=
# Minimal 16 karakter. Vercel Cron mengirimnya otomatis sebagai Authorization: Bearer.
CRON_SECRET=

# Webhook Resend (bounce/spam), dari dashboard Resend > Webhooks. Berawalan whsec_.
RESEND_WEBHOOK_SECRET=

# Bot Telegram dari BotFather. Username tanpa @. Pasang webhook: bun run telegram:webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Web push. Buat pasangan kunci: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:halo@informaticstudyclub.com
